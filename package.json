{
  "name": "lil-zila",
  "version": "0.2.2",
  "description": "Autonomous AI coding companion & anti-cheating mentor for terminal developers, interns, and engineers. Multi-model LLM support (Groq, Gemini, Claude), real-time TUI pairing, automated PR verification, and daily engineering logbook generation.",
  "type": "module",
  "bin": {
    "zila": "./bin/zila.js",
    "lil-zila": "./bin/zila.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md"
  ],
  "preferGlobal": true,
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.ts",
    "dev": "tsc -w",
    "start": "node ./dist/cli.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai",
    "ai-agent",
    "coding-agent",
    "coding-assistant",
    "pair-programming",
    "terminal",
    "terminal-ui",
    "tui",
    "cli",
    "developer-tools",
    "anti-cheat",
    "llm",
    "groq",
    "gemini",
    "claude",
    "ink",
    "react",
    "zigex",
    "zila",
    "lil-zila"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zigxconnect/zila_tui.git"
  },
  "homepage": "https://github.com/zigxconnect/zila_tui#readme",
  "bugs": {
    "url": "https://github.com/zigxconnect/zila_tui/issues"
  },
  "author": "Zigex Open Source Initiative",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "figures": "^6.1.0",
    "ink": "^5.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
